# Public hostname only; never commit the VPS IP or real credentials.
# The Compose deployment publishes HTTPS on 8443 when port 443 is reserved.
# This must exactly match the URL opened in the browser and the Google OAuth origin.
APP_ORIGIN=https://chat.example.com:8443
APP_HOST=chat.example.com
PORT=3000
DATABASE_URL=postgresql://chat:replace_me@db:5432/chat?schema=public&connection_limit=5
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:admin@example.com
SESSION_TTL_DAYS=30
COOKIE_SECURE=true

# Docker-only PostgreSQL bootstrap value.
POSTGRES_PASSWORD=replace_me
