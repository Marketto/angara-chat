{
  "name": "angara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test && node --test deploy/caddyfile.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @angara/api db:generate",
    "db:migrate": "pnpm --filter @angara/api db:migrate"
  }
}
